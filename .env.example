# Frontend (Vite SPA) — only VITE_* reaches the browser bundle. See docs/04.

# Backend API origin. Leave EMPTY in local dev so calls hit the Vite proxy
# (same-origin /api → backend). Set to the deployed API URL in prod builds.
VITE_API_BASE_URL=
VITE_APP_ENV=local

# Google OAuth client id (public by design — NOT the secret).
VITE_GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8000
